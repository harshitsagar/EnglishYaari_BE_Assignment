{
  "info": {
    "_postman_id": "b3f88f12-7b89-4c12-98ab-348e91234567",
    "name": "Session Booking Platform API - EnglishYaari BE Assignment",
    "description": "Postman collection for testing all REST API endpoints for the Session Booking Platform including MongoDB Aggregation Pipelines.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "664c1234567890abcdef1234",
      "type": "string"
    },
    {
      "key": "teacherId",
      "value": "664c1234567890abcdef5678",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "664c1234567890abcdef9012",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. User APIs",
      "item": [
        {
          "name": "API 1 - Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Rahul Sharma\",\n  \"email\": \"rahul.sharma@example.com\",\n  \"phone\": \"+919876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "description": "Creates a new user in the system. Email must be unique."
          },
          "response": []
        },
        {
          "name": "API 6 - User Session List (Aggregation)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/:id/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":id", "sessions"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{userId}}",
                  "description": "User ObjectId"
                }
              ]
            },
            "description": "Returns all sessions for a user separated into Upcoming Sessions and Completed Sessions using MongoDB Aggregation Pipeline."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Teacher APIs",
      "item": [
        {
          "name": "Create Teacher",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ananya Verma\",\n  \"email\": \"ananya.verma@example.com\",\n  \"specialization\": \"Advanced Spoken English & Accent Training\",\n  \"experience\": 6\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/teachers",
              "host": ["{{baseUrl}}"],
              "path": ["teachers"]
            },
            "description": "Creates a new teacher profile."
          },
          "response": []
        },
        {
          "name": "Get All Teachers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/teachers",
              "host": ["{{baseUrl}}"],
              "path": ["teachers"]
            },
            "description": "Fetches all teachers registered in the system."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Session APIs",
      "item": [
        {
          "name": "API 2 - Create Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"2025-05-20T10:00:00.000Z\",\n  \"endTime\": \"2025-05-20T11:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["sessions"]
            },
            "description": "Creates a new session for a teacher with default status AVAILABLE. Validates teacher existence and that endTime > startTime."
          },
          "response": []
        },
        {
          "name": "API 3 - Available Sessions for Booking (Aggregation)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/available?dateTimestamp=2025-05-20",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "available"],
              "query": [
                {
                  "key": "dateTimestamp",
                  "value": "2025-05-20",
                  "description": "Date timestamp (ISO string or timestamp in ms)"
                }
              ]
            },
            "description": "Returns all AVAILABLE sessions for the specified date using MongoDB Aggregation Pipeline ($match, $lookup, $unwind, $project)."
          },
          "response": []
        },
        {
          "name": "API 4 - Book Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/:id/book",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", ":id", "book"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{sessionId}}",
                  "description": "Session ObjectId"
                }
              ]
            },
            "description": "Books an AVAILABLE session for a user. Atomically updates status to BOOKED."
          },
          "response": []
        },
        {
          "name": "API 5 - Mark Session Complete",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/:id/complete",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", ":id", "complete"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{sessionId}}",
                  "description": "Session ObjectId"
                }
              ]
            },
            "description": "Marks a BOOKED session as COMPLETED and updates completedAt timestamp."
          },
          "response": []
        }
      ]
    }
  ]
}
